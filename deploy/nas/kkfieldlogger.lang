[es-es]
name = "KK Field Logger"
auth = "K&K Data Service Inc."
descript = "Evidencia fotográfica de obra para equipos de construcción y campo. Los trabajadores suben fotos, video y recibos desde su teléfono; cada registro lleva el proyecto, el empleado, el GPS y la hora. Los gerentes revisan, anotan, aprueban y generan informes. Funciona por completo en tu NAS: la evidencia queda en tus propios discos."
release_note = "Versión de producción 1.0.001 (corrige un problema de sintaxis del entrypoint del servicio de base de datos detectado en la revisión; sin cambios funcionales): captura de fotos/video/recibos con cola sin conexión; portal de revisión para gerentes con aprobaciones; informes PDF; resúmenes de IA opcionales mediante un backend que usted configura (desactivados por defecto); credenciales de base de datos aleatorias generadas en la instalación; copia de seguridad automática antes de cada actualización; interfaz bilingüe (inglés/chino)."
important = "De uso gratuito. Requiere DockerEngine instalado y habilitado desde el App Center de TOS. Los datos se guardan en DockerAppData del volumen seleccionado; realice copias de seguridad periódicas. Las funciones de IA son opcionales y están desactivadas por defecto; al activarlas, las fotos se envían solo al backend de IA que usted configure. Manual: https://api2.kkdatasvc.com/guide"

