# ============================================================
# KK Field Logger — TOS 7 multilingual file (kkfieldlogger.lang)
# All 14 languages required; untranslated entries carry English.
# ============================================================

[en-us]
name = "KK Field Logger"
auth = "K&K Data Service Inc."
descript = "Jobsite photo evidence for construction and field teams. Crews upload photos, video, and receipts from their phones; every record carries the project, employee, GPS, and time. Managers review, annotate, approve, and build reports. Runs entirely on your NAS, and your data stays on your own drives by default. Optional AI summaries are off until you connect an AI backend of your choice (self-hosted or cloud); only then are photos sent to that backend for analysis."
release_note = "1.0.002 production release: App Center compatibility and audit fixes - db startup on the TOS orchestrator, first-run landing goes straight to the setup wizard, in-app privacy/terms/manual links, working pre-upgrade database backups, and consistent AI-optional wording in every language: photo/video/receipt capture with offline queue; manager review portal with approvals and client-visibility curation; PDF reports; optional AI-assisted summaries via a backend you configure (disabled by default); random database credentials generated at install; automatic pre-upgrade database backups; bilingual (English/Chinese) interface."
important = "Free to use. Requires DockerEngine installed and enabled from the TOS App Center. Data is stored under DockerAppData on the selected volume; keep regular backups. AI features are optional and disabled by default; when enabled, photos are sent only to the AI backend you configure. User manual: https://api2.kkdatasvc.com/guide"

[zh-cn]
name = "KK 现场影像记录"
auth = "K&K Data Service Inc."
descript = "面向工程与外勤团队的工地影像证据系统。工人手机拍照上传，每条记录自动带上项目、工号、GPS 和时间；经理在线审核、批注、审批并生成报告。完全运行在你自己的 NAS 上，数据默认只存在你自己的硬盘里。AI 摘要为可选功能，默认关闭；只有当你主动接入自选的 AI 后端（自建或云端）后，照片才会发送到该后端做分析。"
release_note = "1.0.002 正式版发布：应用中心兼容与审计修复——TOS 编排器下数据库正常启动、首次打开直达初始化向导、应用内隐私/条款/手册链接、升级前自动备份修复、各语言 AI 可选表述统一：照片/视频/票据采集（含离线队列）；经理审核后台（审批与客户可见性管理）；PDF 报告；可选 AI 辅助摘要（默认关闭，后端自行配置）；安装时随机生成数据库凭证；升级前自动备份数据库；中英双语界面。"
important = "免费使用。需要先从 TOS 应用中心安装并启用 DockerEngine。数据存放在所选存储卷的 DockerAppData 下，请定期备份。AI 功能为可选项且默认关闭；开启后照片仅发送至你自行配置的 AI 后端。使用说明书：https://api2.kkdatasvc.com/guide"

[zh-hk]
name = "KK 現場影像記錄"
auth = "K&K Data Service Inc."
descript = "面向工程與外勤團隊的工地影像證據系統。工人手機拍照上傳，每條記錄自動帶上項目、工號、GPS 和時間；經理在線審核、批註、審批並生成報告。完全運行在你自己的 NAS 上，數據默認只存在你自己的硬碟裡。AI 摘要為可選功能，默認關閉；只有當你主動接入自選的 AI 後端（自建或雲端）後，照片才會發送到該後端做分析。"
release_note = "1.0.002 正式版發佈：應用中心相容與審計修復——TOS 編排器下資料庫正常啟動、首次打開直達初始化嚮導、應用內隱私/條款/手冊連結、升級前自動備份修復、各語言 AI 可選表述統一：照片/視頻/票據採集（含離線隊列）；經理審核後台（審批與客戶可見性管理）；PDF 報告；可選 AI 輔助摘要（默認關閉，後端自行配置）；安裝時隨機生成數據庫憑證；升級前自動備份數據庫；中英雙語界面。"
important = "免費使用。需要先從 TOS 應用中心安裝並啟用 DockerEngine。數據存放在所選存儲卷的 DockerAppData 下，請定期備份。AI 功能為可選項且默認關閉；開啟後照片僅發送至你自行配置的 AI 後端。使用說明書：https://api2.kkdatasvc.com/guide"

