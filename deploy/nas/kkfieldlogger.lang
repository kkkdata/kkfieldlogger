[es-es]
name = "KK Field Logger"
auth = "K&K Data Service Inc."
descript = "Evidencia fotográfica de obra para equipos de construcción y campo. Los trabajadores suben fotos, video y recibos desde su teléfono; cada registro lleva el proyecto, el empleado, el GPS y la hora. Los gerentes revisan, anotan, aprueban y generan informes. Funciona por completo en tu NAS y, por defecto, los datos permanecen solo en tus propios discos. Los resúmenes de IA son opcionales y están desactivados hasta que conectes un backend de IA de tu elección (autoalojado o en la nube); solo entonces las fotos se envían a ese backend para su análisis."
release_note = "Versión de producción 1.0.002: correcciones de compatibilidad y auditoría - arranque de la base de datos en el orquestador de TOS, la primera apertura lleva directamente al asistente de configuración, enlaces de privacidad/términos/manual dentro de la app, copias de seguridad previas a la actualización funcionales y redacción coherente de IA opcional en todos los idiomas: captura de fotos/video/recibos con cola sin conexión; portal de revisión para gerentes con aprobaciones; informes PDF; resúmenes de IA opcionales mediante un backend que usted configura (desactivados por defecto); credenciales de base de datos aleatorias generadas en la instalación; copia de seguridad automática antes de cada actualización; interfaz bilingüe (inglés/chino)."
important = "De uso gratuito. Requiere DockerEngine instalado y habilitado desde el App Center de TOS. Los datos se guardan en DockerAppData del volumen seleccionado; realice copias de seguridad periódicas. Las funciones de IA son opcionales y están desactivadas por defecto; al activarlas, las fotos se envían solo al backend de IA que usted configure. Manual: https://api2.kkdatasvc.com/guide"

